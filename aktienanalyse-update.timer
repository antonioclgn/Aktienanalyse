[Unit]
Description=Aktienanalyse: regelmaessig nach Code-Updates suchen

[Timer]
# systemd kennt keine Kommentare hinter einem Wert — deshalb stehen sie hier darueber.
# Erster Check 2 Minuten nach dem Booten, danach jede Minute.
OnBootSec=2min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
